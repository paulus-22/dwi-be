# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://localhost/dwi_api_dev
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-bytes-please
# MUST equal the old app's INVITE_SIGNING_SECRET, or printed QR codes stop verifying.
INVITE_SIGNING_SECRET=change-me
BIND_ADDR=0.0.0.0:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Cloudflare R2 (optional; photo uploads answer 503 without it)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=dwi-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://photos.example.com
# Public invitation site; WhatsApp invite links point here
PUBLIC_SITE_URL=http://localhost:3000
# Fonnte WhatsApp token (optional; without it messages are logged as FAILED, not sent)
# FONNTE_TOKEN=
# Used by `dwi-api seed-demo`
DEMO_ADMIN_PASSWORD=demo-password-123
RUST_LOG=info,dwi_api=debug
